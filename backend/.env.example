# App server
# Your hosting platform may inject PORT automatically, so you normally do not set this yourself in production.
PORT=8000

# OpenAQ v3 (air quality) - optional, but recommended if you want OpenAQ data instead of the Open-Meteo fallback.
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=your_openaq_key
OPENAQ_LAT=-26.2041
OPENAQ_LON=28.0473
OPENAQ_RADIUS=15000

# Meteostat via RapidAPI (climate + weather) - optional, but recommended if you want Meteostat data instead of the Open-Meteo fallback.
METEOSTAT_BASE_URL=https://meteostat.p.rapidapi.com
METEOSTAT_API_KEY=your_rapidapi_key
METEOSTAT_HOST=meteostat.p.rapidapi.com
METEOSTAT_LAT=-26.2041
METEOSTAT_LON=28.0473

# Open-Meteo fallbacks - optional overrides. The defaults below are already correct for most deployments.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# CO2 (Our World in Data JSON)
CO2_JSON_URL=https://owid-public.owid.io/data/co2/owid-co2-data.json
CO2_COUNTRIES=South Africa,Kenya,India,Germany,Nigeria,Egypt,Ethiopia,Tanzania,Uganda,Brazil,Mexico,United States,Canada,France,China,Japan,Australia

# Crops (World Bank API JSON)
CROPS_COUNTRY=ZAF
CROPS_INDICATOR=AG.YLD.MAIZ.KG
CROPS_JSON_URL=https://api.worldbank.org/v2/country/ZAF/indicator/AG.YLD.MAIZ.KG?format=json&per_page=20000

# Initial runtime defaults used before an admin changes the live config in the app.
DEFAULT_COUNTRY=South Africa
DEFAULT_COUNTRY_CODE=ZAF
DEFAULT_LAT=-26.2041
DEFAULT_LON=28.0473
DEFAULT_AQ_RADIUS=15000

# Durable Admin config on Vercel:
# If you connect Upstash Redis from the Vercel Marketplace, Vercel injects these automatically.
# You normally should not type them in by hand in Vercel unless you are wiring a Redis store manually.
# KV_REST_API_URL=https://your-upstash-rest-url
# KV_REST_API_TOKEN=your_upstash_rest_token
# KV_REST_API_READ_ONLY_TOKEN=your_upstash_read_only_token
# Optional custom key name for the stored runtime config document.
# RUNTIME_CONFIG_KV_KEY=climatefood:runtime_config
#
# If you connect to Upstash directly outside the Vercel Marketplace, these aliases are also supported:
# UPSTASH_REDIS_REST_URL=https://your-upstash-rest-url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=your_upstash_read_only_token

# Advanced: override the backend runtime-config file path if needed.
# On Vercel, the backend still mirrors config to /tmp/runtime_config.json, but durable persistence should come from Redis.
# RUNTIME_CONFIG_PATH=/app/data/runtime_config.json
